root = true

[*.{py}]
charset = utf-8
end_of_line = lf
indent_style = space
tab_width = 4
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,js,jsx,ts,tsx,html}]
charset = utf-8
end_of_line = lf
indent_style = space
tab_width = 2
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
